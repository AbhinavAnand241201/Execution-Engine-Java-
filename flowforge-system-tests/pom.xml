<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.flowforge</groupId>
        <artifactId>flowforge-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>flowforge-system-tests</artifactId>
    <name>FlowForge System Tests</name>
    <description>Orchestrator and workers booted in one JVM against Testcontainers (Phase 4+).</description>

    <dependencies>
        <!-- Plain (non-repackaged) jars, so their classes are on the test classpath. -->
        <dependency>
            <groupId>com.flowforge</groupId>
            <artifactId>flowforge-orchestrator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.flowforge</groupId>
            <artifactId>flowforge-worker</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.flowforge</groupId>
            <artifactId>flowforge-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.flowforge</groupId>
            <artifactId>flowforge-runtime</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

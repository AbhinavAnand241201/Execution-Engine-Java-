# Copy to .env and replace every placeholder. .env is git-ignored; never commit real values.

# --- Local development (docker compose) ---
POSTGRES_DB=flowforge
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=change-me

# JWT HMAC key, at least 32 bytes: openssl rand -base64 48
FLOWFORGE_JWT_SECRET=change-me

# Seeded accounts (optional operator is for demos)
FLOWFORGE_ADMIN_EMAIL=admin@example.com
# At least 10 characters and at most 72 bytes (startup fails otherwise)
FLOWFORGE_ADMIN_PASSWORD=change-me-to-a-long-password
FLOWFORGE_OPERATOR_EMAIL=
FLOWFORGE_OPERATOR_PASSWORD=

# Protects worker chaos endpoints: openssl rand -hex 24
FLOWFORGE_CHAOS_TOKEN=change-me

# SSRF allowlist for HTTP tasks
FLOWFORGE_HTTP_ALLOWED_HOSTS=wiremock,localhost

# --- Deployment only ---
DOMAIN=
ACME_EMAIL=
REDIS_PASSWORD=
